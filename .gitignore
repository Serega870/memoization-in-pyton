from collections import namedtuple
from functools import lru_cache


Node = namedtuple("Node", ["value", "left", "right"])


def gen_bin_tree_with_namedtuple(
    root=1,
    height=5,
    left_leaf=None,
    right_leaf=None,
):
    """Строит дерево с мемоизацией, возвращая узлы namedtuple."""
    if left_leaf is None:
        left_leaf = lambda x: x * 2

    if right_leaf is None:
        right_leaf = lambda x: x + 3

    # Кеш создаётся отдельно для каждого вызова функции.
    # Алгоритмы left_leaf и right_leaf фиксируются в замыкании.
    @lru_cache(maxsize=None)
    def make_node(value, remaining_height):
        if remaining_height <= 0:
            return Node(value, None, None)

        return Node(
            value=value,
            left=make_node(
                left_leaf(value),
                remaining_height - 1,
            ),
            right=make_node(
                right_leaf(value),
                remaining_height - 1,
            ),
        )

    return make_node(root, height)


def gen_bin_tree(
    root=1,
    height=5,
    left_leaf=None,
    right_leaf=None,
):
    """Строит дерево с мемоизацией и возвращает вложенные словари."""
    cached_tree = gen_bin_tree_with_namedtuple(
        root=root,
        height=height,
        left_leaf=left_leaf,
        right_leaf=right_leaf,
    )

    def to_dict(node):
        if node is None:
            return None

        # Для каждого положения в дереве создаётся свой словарь.
        # Изменение одной ветки не затронет другую.
        return {
            "value": node.value,
            "left": to_dict(node.left),
            "right": to_dict(node.right),
        }

    return to_dict(cached_tree)
